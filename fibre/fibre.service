# /etc/systemd/system/fibre.service — VALIDEXIS template
[Unit]
Description=Celestia Fibre server
After=network-online.target
Wants=network-online.target

[Service]
User=fibre
# /var/lib/fibre is mounted on the dedicated shard disk
ExecStart=/usr/local/bin/fibre start --home /var/lib/fibre --otel-endpoint http://<otel_collector>:4318
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
